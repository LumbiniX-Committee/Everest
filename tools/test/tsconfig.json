{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "//": "Typechecks the device-independent logic in core/ and shared/. The Expo app (app/, features/, components/, …) is typechecked by the root project's own tsconfig, not here.",
  "include": ["../../shared/**/*.ts", "../../core/**/*.ts"]
}
