# Files EAS Build does not need in the project archive.
#
# .easignore replaces .gitignore for the upload, so anything ignored for git
# that must also stay out of the build has to be repeated here.

node_modules/
tools/test/node_modules/
.expo/
dist/
dist_test/
web-build/

# Generated native folders (EAS runs clean prebuild in the cloud)
/android/
/ios/

# The APK download landing page. A standalone Next.js app that shares nothing
# with the Expo project.
/landing/

# Root-level large LLM weights (downloaded dynamically, never bundled: ~484MB).
# NOTE: The root slash is critical so assets/models/crack-seg.onnx is NOT excluded.
/models/
!assets/models/
!assets/models/**

# Harvest pipeline working directories and raw crawl imagery (~604MB)
/harvest/

# Local binaries, virtual environments, and scratch files
ngrok.exe
.venv/
venv/
scratch/
.agents/
dhammaupdate/
imagesupdate/

# Documentation and presentations never needed for mobile builds
/docs/
/docsv2/
/ictawarddocs/
google-play-service-account.json

# Local environment files (EAS uses its own remote environment secrets)
.env
.env.*
!.env.example

# Logs and OS files
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
