# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
tools/test/node_modules/
tools/test/package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Store submission credentials. The Play service account JSON grants release
# rights to the app — it is a secret, and *.key above does not cover a .json.
google-play-service-account.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env.local holds the Supabase config and is required to run — see .env.example.
# Every .env variant is ignored, including a bare `.env`, which `.env*.local`
# alone would have let through.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Agent working files. Coordination state and throwaway verification scripts
# from automated sessions — the code they produced is committed, the scaffolding
# around it is not. PROJECT.md and TEST_INFRA.md are kept: those are documents
# about the project rather than about a run.
.agents/
scratch/

# generated native folders
/ios
/android

# harvest output (large; regenerated from scripts)
harvest/_raw/
harvest/_images/
*.pyc
__pycache__/
.venv/
venv/

# scratch
*.log
osm.json

# harvest working dirs (regenerated by scripts)
harvest/_jp2/
harvest/_pages/
harvest/_hires/
harvest/_crops/

# Narration audio is NOT ignored. Metro resolves require() at bundle time, so
# an asset the app statically requires must be in the repository — ignoring
# these broke the bundle for everyone who had not run the generator locally.
# Generate with tools/make-narration-audio.ps1, then commit the output and
# register each file in data/audio.ts.

# Claude Code local settings
.claude/settings.local.json
