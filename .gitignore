# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
tools/test/node_modules/
tools/test/package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env.local holds the Supabase config and is required to run — see .env.example.
# Every .env variant is ignored, including a bare `.env`, which `.env*.local`
# alone would have let through.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# harvest output (large; regenerated from scripts)
harvest/_raw/
harvest/_images/
*.pyc
__pycache__/
.venv/
venv/

# scratch
*.log
osm.json

# harvest working dirs (regenerated by scripts)
harvest/_jp2/
harvest/_pages/
harvest/_hires/
harvest/_crops/

# generated narration audio (robotic SAPI placeholders; regenerate via tools/make-narration-audio.ps1)
app/assets/audio/*.opus
