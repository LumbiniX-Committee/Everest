{
  "name": "sakshi",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "index.tsx",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "api": "node --env-file-if-exists=.env.local --experimental-strip-types mock-api/server.mjs",
    "android": "expo start",
    "ios": "expo start",
    "dev-client": "expo start --dev-client --lan",
    "build:development": "npx eas-cli@latest build --profile development --platform android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tools/test/tsconfig.json",
    "lint": "expo lint",
    "gen": "node tools/gen-data.mjs",
    "catalog:plan": "node tools/sync-catalog.mjs",
    "catalog:apply": "node tools/sync-catalog.mjs --apply",
    "seed:staging:plan": "node tools/seed-history-supabase.mjs",
    "seed:staging:apply": "node tools/seed-history-supabase.mjs --apply",
    "release:check": "node --env-file-if-exists=.env.local tools/check-release-config.mjs",
    "eas-build-pre-install": "node tools/check-release-config.mjs",
    "test": "node tools/run-tests.mjs",
    "test:react": "jest --runInBand --config jest.config.js",
    "validate": "node tools/validate-seed.mjs",
    "vocab": "node tools/lint-vocab.mjs",
    "i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tools/validate-i18n.mjs",
    "verify": "npm run typecheck && npm run typecheck:core && npm run test && npm run test:react && npm run validate && npm run vocab && npm run i18n && npm run eval:dhamma && npm run lint",
    "eval:dhamma": "node tools/dhamma-eval.mjs",
    "corpus:fetch": "node tools/fetch-bilara.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/anek-devanagari": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-sensors": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "jpeg-js": "^0.4.4",
    "llama.rn": "^0.12.6",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
