# Copy to .env.local and fill in. .env.local is gitignored and never committed.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time,
# so they are readable by anyone with the app. Only ever put publishable values
# here — the Supabase key below is the publishable (anon) key, which is designed
# to be shipped in client code and is safe to expose. A service-role key must
# never appear in this file.
#
# Row Level Security is what actually protects the data. It has to be enabled on
# every table before observations sync.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
