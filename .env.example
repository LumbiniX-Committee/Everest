# Copy to .env.local and fill in. .env.local is gitignored and never committed.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time,
# so they are readable by anyone with the app. Only ever put publishable values
# here — the Supabase key below is the publishable (anon) key, which is designed
# to be shipped in client code and is safe to expose. A service-role key must
# never appear in this file.
#
# Row Level Security is what actually protects the data. It has to be enabled on
# every table before observations sync.

# --- App backend: Supabase (required to run the app) ------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# --- Mock API (local dev, optional) -----------------------------------------
# The zero-dep mock in mock-api/ serves the site/quest/merit contract offline.
# Point the phone at this machine's LAN IP + port (see mock-api/README.md) —
# NOT localhost, which on the phone means the phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Mock API only reads this. Default 8000.
PORT=8000

# --- Harvest pipeline (lane D) ----------------------------------------------
# Mapillary: free token at https://www.mapillary.com/dashboard/developers.
# Wikimedia geosearch needs no key, so 01_fetch_wikimedia.py runs without this.
MAPILLARY_TOKEN=
# Flickr: https://www.flickr.com/services/apps/create/apply — optional imagery.
FLICKR_API_KEY=

# Optional. Enables the AI second opinion on quest photographs. Without it the
# app works unchanged and reviews report "unavailable" — the feature is
# advisory, so nothing depends on it.
#
# EXPO_PUBLIC_ is inlined into the bundle and readable by anyone with the APK.
# Use a scoped, rotatable demo key only; a key that must stay secret belongs
# behind a server the app calls, not in the client.
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_ENDPOINT=https://ollama.com/v1/chat/completions
EXPO_PUBLIC_VISION_MODEL=gemma4:31b
