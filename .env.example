# Sākṣī — environment template
#
# Copy to `.env` and fill in. Never commit `.env`. Each key notes which lane
# needs it and where to get it. Keys the mock API does not need are still listed
# so nobody is surprised at hour 30.

# --- App (lane A/B) ---------------------------------------------------------
# Base URL the phone talks to. During local dev this is this machine's LAN IP
# and the mock API's port (see mock-api/README.md) — NOT localhost, which on
# the phone means the phone. After the Railway deploy, paste that URL here.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# --- AR: ReactVision Studio (lane B) ----------------------------------------
# Free account at https://www.reactvision.xyz — geospatial anchors (04 §7).
RV_API_KEY=
RV_PROJECT_ID=

# --- Harvest (lane D) -------------------------------------------------------
# Mapillary: free token at https://www.mapillary.com/dashboard/developers.
# Wikimedia geosearch needs no key, so 01_fetch_wikimedia.py runs without this.
MAPILLARY_TOKEN=
# Flickr: https://www.flickr.com/services/apps/create/apply — optional imagery.
FLICKR_API_KEY=

# --- Backend (lane C) -------------------------------------------------------
# Postgres 16 + PostGIS. Railway/Render provision this.
DATABASE_URL=postgresql://user:pass@host:5432/saksi

# Cloudflare R2 (S3-compatible) for capture images and plates.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saksi-captures
R2_ENDPOINT=

# --- Dhamma engine (lane C) -------------------------------------------------
# Two providers so one can fall back to the other (06 §6). Paid.
LLM_PRIMARY_API_KEY=
LLM_FALLBACK_API_KEY=

# --- Ops --------------------------------------------------------------------
# Optional error reporting.
SENTRY_DSN=

# Mock API only reads this. Default 8000.
PORT=8000
