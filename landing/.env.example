# --- Production portal: Supabase ---------------------------------------------
# Both values are publishable. Row Level Security is the authorization boundary;
# never add a service-role key to a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- APK download (app/page.tsx, lib/eas.ts) ----------------------------------
# Server-only: an Expo access token with read access to the project's builds.
# Optional — without it the page serves the pinned FALLBACK build in lib/eas.ts.
EXPO_TOKEN=
