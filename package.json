{
  "name": "sakshi",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "api": "node --env-file-if-exists=.env.local --experimental-strip-types mock-api/server.mjs",
    "android": "expo start",
    "ios": "expo start",
    "dev-client": "expo start --dev-client --lan",
    "build:development": "npx eas-cli@latest build --profile development --platform android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "gen": "node tools/gen-data.mjs",
    "test": "node tools/run-tests.mjs",
    "validate": "node tools/validate-seed.mjs",
    "vocab": "node tools/lint-vocab.mjs",
    "verify": "npm run typecheck && npm run test && npm run validate && npm run vocab && npm run eval:dhamma",
    "eval:dhamma": "node tools/dhamma-eval.mjs",
    "corpus:fetch": "node tools/fetch-bilara.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/anek-devanagari": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-sensors": "~57.0.2",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.12",
    "jpeg-js": "^0.4.4",
    "llama.rn": "^0.12.6",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
