# --- Custodian dashboard (app/custodian) -------------------------------------
# Public: read client-side. Point this at mock-api/server.mjs locally, or at
# its deployed URL (see mock-api/railway.json). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- APK download (app/page.tsx, lib/eas.ts) ----------------------------------
# Server-only: an Expo access token with read access to the project's builds.
# Optional — without it the page serves the pinned FALLBACK build in lib/eas.ts.
EXPO_TOKEN=
